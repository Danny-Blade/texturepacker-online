{
  "name": "texturepacker-online",
  "version": "0.1.0",
  "private": true,
  "bin": {
    "wtp": "./bin/wtp.mjs"
  },
  "scripts": {
    "worker:build": "node scripts/build-packer-worker.mjs && node scripts/build-png8-worker.mjs",
    "cli:build": "node scripts/build-cli.mjs",
    "predev": "npm run worker:build",
    "dev": "next dev",
    "prebuild": "npm run worker:build",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "docker:build": "docker build -t wtp:local .",
    "docker:run": "docker run --rm -p 3000:3000 wtp:local"
  },
  "dependencies": {
    "jszip": "^3.10.1",
    "next": "16.1.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.2",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
